generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  phone       String       @unique
  displayName String?
  city        String?
  birthYear   Int?
  role        String       @default("member") // member | filmmaker | editor | admin
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sessions    Session[]
  resume      ActorResume?
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ClassEvent {
  id          String   @id @default(cuid())
  title       String
  teacher     String?
  description String?
  location    String?
  startsAt    DateTime
  durationMin Int?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
}

model ActorResume {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  headline    String?
  bio         String?
  gender      String?
  city        String?
  birthYear   Int?
  heightCm    Int?
  skills      String?
  experience  String?
  photoUrl    String?
  showreelUrl String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublic])
}

model GalleryItem {
  id          String   @id @default(cuid())
  imageUrl    String
  caption     String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model BookChunk {
  id        String   @id @default(cuid())
  idx       Int
  content   String
  embedding Json
  createdAt DateTime @default(now())

  @@index([idx])
}

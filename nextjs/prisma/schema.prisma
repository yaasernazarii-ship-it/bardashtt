generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  phone        String       @unique
  displayName  String?
  city         String?
  birthYear    Int?
  role         String       @default("member") // member | student | filmmaker | editor | admin
  username     String?      @unique
  passwordHash String?
  passwordPlain String? // رمز عبورِ صادرشده توسط مدیر، برای ارسال مجدد در صورت فراموشی
  active       Boolean      @default(true) // غیرفعال‌سازی حساب توسط ادمین/ادیتور
  graduated    Boolean      @default(false) // فارغ‌التحصیل؟ در این حالت تقویم کلاس از داشبورد حذف و از انتخاب اسامی کنار می‌رود
  nationalId   String?
  branch       String? // تهران | ساری
  courseTitle  String? // دوره‌ای که هنرجو در آن است
  classGroupId String? // کلاس/گروه هنرجو
  classGroup   ClassGroup?  @relation(fields: [classGroupId], references: [id])
  scheduleSeenAt DateTime? // آخرین باری که هنرجو برنامه‌اش را دید (برای نوتیفیکیشن)
  progressOverride Int? // درصد پیشرفتِ دستیِ تعیین‌شده توسط ادمین/ادیتور؛ اگر تنظیم شود جای محاسبهٔ خودکار (بر پایه‌ی حضور) را می‌گیرد
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  resume       ActorResume?
  enrollments  Enrollment[]
  attendances  Attendance[]
  payments     Payment[]

  @@index([classGroupId])
}

model ClassGroup {
  id            String         @id @default(cuid())
  name          String // نام کلاس/گروه
  branch        String // تهران | ساری
  courseTitle   String? // دوره
  totalSessions Int            @default(8) // تعداد کل جلسات این دوره (مبنای محاسبه‌ی درصد پیشرفت هنرجو)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  members       User[]
  sessions      ClassSession[]

  @@index([branch])
}

model ClassSession {
  id               String       @id @default(cuid())
  groupId          String
  group            ClassGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title            String
  startsAt         DateTime
  chartDescription String? // چارت درسی جلسه
  tools            String? // ابزار لازم برای جلسه
  homework         String? // تمرین و اتود جلسه
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attendances      Attendance[]

  @@index([groupId, startsAt])
}

model Attendance {
  id        String       @id @default(cuid())
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String       @default("absent") // present | absent
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
}

model SignupRequest {
  id         String   @id @default(cuid())
  role       String // student | filmmaker
  firstName  String
  lastName   String
  phone      String
  nationalId String? // کد ملی (برای فیلمساز)
  branch     String? // تهران | ساری (برای هنرجو)
  birthDate  String? // تاریخ تولد (برای هنرجو)
  idCardImage String? // عکس شناسنامه یا کارت ملی (برای هنرجو)
  goal       String? // هدف از انتخاب خانواده برداشت (برای فیلمساز)
  status     String   @default("pending") // pending | approved | rejected
  username   String? // نام کاربری ساخته‌شده هنگام تأیید
  userId     String? // حساب کاربری ساخته‌شده پس از تأیید
  adminNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([phone])
}

model BookingRequest {
  id          String   @id @default(cuid())
  actorId     String // شناسهٔ رزومهٔ بازیگر
  actorName   String // نام بازیگر (کپی برای نمایش سریع)
  userId      String? // فیلمساز/کاربر ثبت‌کننده
  name        String // نام تماس‌گیرنده
  phone       String // شماره تماس
  message     String // پیام/توضیح ست تایم
  status      String   @default("new") // new | contacted | done | rejected
  adminNote   String? // یادداشت ادمین/ادیتور
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([actorId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ClassEvent {
  id          String   @id @default(cuid())
  title       String
  teacher     String?
  description String?
  location    String?
  startsAt    DateTime
  durationMin Int?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
}

model ActorResume {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  headline    String?
  bio         String?
  gender      String?
  city        String?
  birthYear   Int?
  heightCm    Int?
  skills      String?
  experience  String?
  photoUrl    String?
  showreelUrl String?
  selfVideoUrl String? // ویدیوی معرفی که خودِ هنرجو بارگذاری می‌کند (لینک آپارات/درایو/…)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublic])
}

model GalleryItem {
  id          String   @id @default(cuid())
  imageUrl    String
  caption     String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model BookChunk {
  id        String   @id @default(cuid())
  idx       Int
  content   String
  embedding Json
  createdAt DateTime @default(now())

  @@index([idx])
}

model SupportConversation {
  id            String           @id @default(cuid())
  visitorName   String
  visitorPhone  String?
  status        String           @default("open") // open | closed
  lastMessageAt DateTime         @default(now())
  adminUnread   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  messages      SupportMessage[]

  @@index([lastMessageAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // visitor | admin
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  section     String    @default("news") // بخش مقصد: news, blog, works-*, gallery, course-video
  excerpt     String? // خلاصهٔ کوتاه برای فهرست
  body        String // متن اصلی (پاراگراف‌ها با خط جدید)
  coverImage  String? // نشانی عکس کاور (آپلودی یا URL)
  aparatUrl   String? // لینک ویدیوی آپارات
  published   Boolean   @default(true)
  publishAt   DateTime? // زمان انتشار زمان‌بندی‌شده؛ خالی یعنی فوری
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, createdAt])
  @@index([section, published, publishAt])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id          String   @id @default(cuid())
  courseKey   String // شناسه دوره (۰۱ تا ۰۵)
  courseTitle String
  fullName    String
  phone       String
  status      String   @default("submitted") // submitted | approved | rejected
  answers     Json? // پاسخ‌های تست آنلاین
  actorType   String? // تیپ بازیگری تشخیص‌داده‌شده توسط هوش مصنوعی
  aiAnalysis  String? // تحلیل متنی هوش مصنوعی
  videoUrl    String? // لینک ویدیوی ارسالی هنرجو
  nationalId  String? // کد ملی هنرجو (برای تطبیق ویدیوی فرم با درخواست)
  adminNote   String? // یادداشت/دلیل ادمین
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([phone])
}

// پرداختِ هنرجو: شهریهٔ هر دوره، یا هزینه‌های جدا (بیمه/پلاتو، لوکیشن/تغذیه، افیشِ متفرقه).
// هر پرداخت یک مبلغِ متغیر و یک «بابت/دلیل» دارد و می‌تواند به یکی از ۵ دوره وصل باشد یا جدا (courseKey خالی).
model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String // بابت/دلیل پرداخت (مثلاً «شهریهٔ دورهٔ تکمیلی» یا «هزینهٔ بیمه و پلاتو»)
  courseKey   String? // اگر مربوط به یکی از ۵ دوره باشد (۰۱ تا ۰۵)؛ برای پرداخت‌های جدا خالی است
  courseTitle String? // عنوان دورهٔ مرتبط (در صورت وجود)
  amount      Int // مبلغ به تومان (متغیر؛ ادمین هنگام ساخت وارد می‌کند)
  status      String    @default("pending") // pending | paid | canceled
  method      String? // روش پرداخت: online | manual (بعد از اتصال درگاه پر می‌شود)
  paidAt      DateTime? // زمان پرداخت موفق
  createdById String? // ادمین/ادیتوری که این پرداخت را ساخته
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([status])
}

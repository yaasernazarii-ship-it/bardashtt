generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  phone       String       @unique
  displayName String?
  city        String?
  birthYear   Int?
  role        String       @default("member") // member | filmmaker | editor | admin
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sessions    Session[]
  resume      ActorResume?
  enrollments Enrollment[]
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ClassEvent {
  id          String   @id @default(cuid())
  title       String
  teacher     String?
  description String?
  location    String?
  startsAt    DateTime
  durationMin Int?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
}

model ActorResume {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  headline    String?
  bio         String?
  gender      String?
  city        String?
  birthYear   Int?
  heightCm    Int?
  skills      String?
  experience  String?
  photoUrl    String?
  showreelUrl String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublic])
}

model GalleryItem {
  id          String   @id @default(cuid())
  imageUrl    String
  caption     String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model BookChunk {
  id        String   @id @default(cuid())
  idx       Int
  content   String
  embedding Json
  createdAt DateTime @default(now())

  @@index([idx])
}

model SupportConversation {
  id            String           @id @default(cuid())
  visitorName   String
  visitorPhone  String?
  status        String           @default("open") // open | closed
  lastMessageAt DateTime         @default(now())
  adminUnread   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  messages      SupportMessage[]

  @@index([lastMessageAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // visitor | admin
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String? // خلاصهٔ کوتاه برای فهرست
  body        String // متن اصلی (پاراگراف‌ها با خط جدید)
  coverImage  String? // نشانی عکس کاور (آپلودی یا URL)
  aparatUrl   String? // لینک ویدیوی آپارات
  published   Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id          String   @id @default(cuid())
  courseKey   String // شناسه دوره (۰۱ تا ۰۵)
  courseTitle String
  fullName    String
  phone       String
  status      String   @default("submitted") // submitted | approved | rejected
  answers     Json? // پاسخ‌های تست آنلاین
  actorType   String? // تیپ بازیگری تشخیص‌داده‌شده توسط هوش مصنوعی
  aiAnalysis  String? // تحلیل متنی هوش مصنوعی
  videoUrl    String? // لینک ویدیوی ارسالی هنرجو
  nationalId  String? // کد ملی هنرجو (برای تطبیق ویدیوی فرم با درخواست)
  adminNote   String? // یادداشت/دلیل ادمین
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([phone])
}
